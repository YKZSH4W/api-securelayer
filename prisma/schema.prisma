// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// Define el modelo de datos para la base de datos utilizando Prisma
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// Definicion del tipo de base de datos a utilizar
datasource db {
  provider = "mysql"
}

// Diseño de la base de datos

model Users {
  id Int @id @default(autoincrement())
  email String @unique
  password String
  name String
  lastName String
  totalXp Int
  lastAccessed DateTime
  streak Int
  knowledgeLevel String
  profilePicture String? @db.LongText
  userAchievements Usersachievements[]
  enrolls Enrolls[]
  attempts Attempts[]
  activitiesProgress activitiesProgress[]
}

model Usersachievements {
  id Int @id @default(autoincrement())
  userId Int
  achievementId Int
  dateAchieved DateTime
  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievements @relation(fields: [achievementId], references: [id], onDelete: Cascade)
}

model Achievements {
  id Int @id @default(autoincrement())
  name String
  description String
  icon String
  requiredXp Int
  user Usersachievements[]
}

model Routes {
  id Int @id @default(autoincrement())
  level String
  name String
  difficulty String
  description String
  isCompleted Boolean @default(false)
  lessons Lessons[]
  enrolls Enrolls[]
  routesAdvices routesAdvices[]
}

model Lessons {
  id Int @id @default(autoincrement())
  routeId Int
  name String
  description String
  icon String
  route Routes @relation(fields: [routeId], references: [id], onDelete: Cascade)
  activities Activities[]
  lessonsAdvices lessonsAdvices[]
}

model Activities {
  id Int @id @default(autoincrement())
  lessonId Int
  name String
  description String
  icon String
  type String
  xp Int
  category String?
  lesson Lessons @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Questions[]
  attempts Attempts[]
  activitiesProgress activitiesProgress[]
  phishingSimulations PhishingSimulations[]
}

model Questions {
  id Int @id @default(autoincrement())
  activityId Int
  questionText String
  explanation String
  type String
  order Int
  activity Activities @relation(fields: [activityId], references: [id], onDelete: Cascade)
  options Options[]
}

model Options {
  id Int @id @default(autoincrement())
  questionId Int
  optionText String
  isCorrect Boolean
  question Questions @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Enrolls {
  id Int @id @default(autoincrement())
  userId Int
  routeId Int
  enrollmentDate DateTime
  finishDate DateTime?
  isCompleted Boolean
  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
  route Routes @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([userId, routeId])
}

model Attempts {
  id Int @id @default(autoincrement())
  userId Int
  activityId Int
  attemptDate DateTime
  isCorrect Boolean
  score Int
  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activities @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model activitiesProgress {
  id Int @id @default(autoincrement())
  activityId Int
  userId Int
  progress Int
  isCompleted Boolean
  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activities @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model routesAdvices {
  id Int @id @default(autoincrement())
  routeId Int
  type String
  adviceTitle String
  adviceText String
  route Routes @relation(fields: [routeId], references: [id], onDelete: Cascade)
}

model lessonsAdvices {
  id Int @id @default(autoincrement())
  lessonId Int
  type String
  adviceTitle String
  adviceText String
  lesson Lessons @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model PhishingSimulations {
  id Int @id @default(autoincrement())
  activityId Int
  typeMessage String
  sender String
  content String
  isScam Boolean
  activity Activities @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

